{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(./gradlew assembleGmsMobileUniversalDebug:*)",
      "Bash(./gradlew :app:testGmsMobileUniversalDebugUnitTest:*)",
      "Bash(python3 scripts/check_repository.py:*)",
      "Bash(python3 -m unittest discover -s scripts:*)"
    ],
    "deny": [
      "Read(./local.properties)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
